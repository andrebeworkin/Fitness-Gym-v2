# Public URLs & Supabase (anon key is safe for browser with RLS).
# See docs/ENVIRONMENT.md
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "true" = skip Supabase session + role checks in middleware/layouts (UI dev only; never production)
NEXT_PUBLIC_DEV_AUTH_BYPASS=false

# Server-only (never commit real values) — optional admin scripts
# SUPABASE_SERVICE_ROLE_KEY=
